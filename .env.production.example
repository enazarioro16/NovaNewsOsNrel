# ========================================================
# NovaNews OS - Plantilla de Entorno de Producción
# ========================================================

# 1. Credenciales de Base de Datos PostgreSQL
POSTGRES_USER=novanews
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA
POSTGRES_DB=novanews_prod_db
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}

# 2. Configuración del Motor de IA (Semantic Core)
# Reemplazar con la API Key real de Google AI Studio (Gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 3. Identidad y Sesiones (B2C)
# NEXTAUTH_URL debe ser tu dominio público, ej. https://novanews.tudominio.com
NEXTAUTH_URL=http://localhost:3000
# Genera un hash aleatorio: `openssl rand -base64 32`
NEXTAUTH_SECRET=CAMBIA_ESTO_POR_UN_HASH_SEGURO

# 4. Seguridad de Webhooks Externos (n8n, CRM)
# Llave estática (M2M) inyectada en n8n y validada por NestJS ApiKeyAuthGuard
M2M_API_KEY=super-secret-m2m-token-change-me

# 5. Configuración de Caddy (Reverse Proxy)
# Correo para registros de certificados SSL (Let's Encrypt)
TLS_EMAIL=admin@tudominio.com
# Dominios (Ej. app.midominio.com)
DOMAIN_WEB=novanews.tudominio.com
DOMAIN_N8N=n8n.tudominio.com
DOMAIN_API=api.tudominio.com
